# Spill Sense (SIH26143) — Example Environment Configuration
# Copy this file to .env and fill in your confidential API credentials.

DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/spill_sense
REDIS_URL=redis://localhost:6379/0

# Copernicus Data Space Ecosystem (CDSE) OAuth Credentials
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=
CDSE_USERNAME=
CDSE_PASSWORD=

# Live AISStream WebSocket Token (https://aisstream.io/)
AISSTREAM_API_KEY=
